{
  "name": "prompt2task",
  "version": "0.1.7",
  "description": "Local-first CLI that turns natural-language prompts into structured tasks and sends them to AI providers",
  "type": "module",
  "bin": {
    "prompt2task": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "tsup --watch",
    "prepublishOnly": "npm run build",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "cli",
    "ai",
    "prompt",
    "task",
    "openai",
    "claude"
  ],
  "license": "MIT",
  "dependencies": {
    "@inquirer/prompts": "^7.5.2",
    "chalk": "^5.3.0",
    "cli-table3": "^0.6.5",
    "clipboardy": "^4.0.0",
    "commander": "^12.1.0",
    "drizzle-orm": "^0.45.2",
    "ora": "^8.1.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "drizzle-kit": "^0.30.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
